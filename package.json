    "aws-jwt-verify": "^5.2.1",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1135.0",
    "@aws-sdk/client-dynamodb": "^3",
    "@aws-sdk/client-lambda": "^3.1136.0",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/client-secrets-manager": "^3.1135.0",
    "@aws-sdk/client-sesv2": "^3",
    "@aws-sdk/lib-dynamodb": "^3",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@types/aws-lambda": "^8.10",
    "@types/node": "^22",
    "aws-cdk": "^2.1136.0",
    "esbuild": "^0.25",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  }
