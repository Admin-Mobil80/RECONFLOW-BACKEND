{
  "name": "reconflow-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ReconFlow AWS infrastructure — CDK app (the only sanctioned way ReconFlow resources are created)",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "cdk synth",
    "diff": "cdk diff",
